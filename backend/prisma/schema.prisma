generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  username      String
  email         String    @unique
  password      String
  accountActive Boolean   @default(false)
  isLogin       Boolean   @default(false)
  verifyCode    String?
  lastLogin     DateTime?
  createdDate   DateTime  @default(now())
  updatedDate   DateTime  @updatedAt

  @@index([username])
  @@map("users")
}
